# Generate a different value for every environment, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Configure these once to bootstrap the first administrator.
# INITIAL_ADMIN_EMAIL=admin@example.gov.in
# INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Required only when enabling Google sign-in.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
